# CartNova backend configuration.
#
# IMPORTANT — this file documents the variable names your Spring Boot backend reads
# (see backend/src/main/resources/application.properties), but plain Spring Boot does NOT
# auto-load a .env file the way Node/Vite projects do. There is no .env-loading dependency
# wired into this project. Use ONE of these two approaches instead:
#
#   Option A (recommended for a quick local demo on Windows):
#     Open backend/src/main/resources/application.properties and edit the default values
#     directly - each line already has the form ${DB_URL:default-value}, so you can just
#     replace the part after the colon.
#
#   Option B (keeps secrets out of the file, closer to production practice):
#     Set real environment variables before starting the backend. On Windows cmd:
#       set DB_URL=jdbc:mysql://localhost:3306/shopping_db
#       set DB_USERNAME=root
#       set DB_PASSWORD=your_real_password
#       set JWT_SECRET=a-long-random-string-of-your-choosing
#       mvn spring-boot:run
#     (On PowerShell use $env:DB_URL="..." instead of set.)

DB_URL=jdbc:mysql://localhost:3306/shopping_db
DB_USERNAME=root
DB_PASSWORD=change-me
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRATION_MS=86400000
